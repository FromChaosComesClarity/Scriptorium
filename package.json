{
  "name": "scriptorium",
  "version": "0.2.1",
  "description": "A visual Markdown editor for Simplenote",
  "main": "out/main/index.js",
  "author": "FromChaosComesClarity",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "roundtrip": "node --experimental-vm-modules scripts/roundtrip.mjs",
    "test": "node scripts/roundtrip.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage",
    "dist:mac": "electron-vite build && electron-builder --mac dmg --arm64",
    "dist:mac:zip": "electron-vite build && electron-builder --mac zip --arm64",
    "postdist": "npm run deploy",
    "deploy": "if [ -f dist/Scriptorium.AppImage ]; then mkdir -p ~/Apps/Scriptorium && cp dist/Scriptorium.AppImage ~/Apps/Scriptorium/.deploy.tmp && chmod +x ~/Apps/Scriptorium/.deploy.tmp && mv -f ~/Apps/Scriptorium/.deploy.tmp ~/Apps/Scriptorium/Scriptorium.AppImage && echo \"Deployed. A running copy keeps the old build until you quit it.\"; fi",
    "deploy:mac": "if [ -d dist/mac-arm64/Scriptorium.app ]; then rm -rf /Applications/.Scriptorium.deploy.tmp && cp -R dist/mac-arm64/Scriptorium.app /Applications/.Scriptorium.deploy.tmp && rm -rf /Applications/Scriptorium.app && mv /Applications/.Scriptorium.deploy.tmp /Applications/Scriptorium.app && echo \"Deployed to /Applications. Quit a running copy first: unlike an AppImage, a .app bundle does not survive being replaced underneath it.\"; fi",
    "postdist:linux": "npm run deploy",
    "postdist:mac": "npm run deploy:mac"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.2.7",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/audiowide": "^5.2.7",
    "@fontsource/black-ops-one": "^5.2.8",
    "@fontsource/bungee": "^5.2.7",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/courier-prime": "^5.2.8",
    "@fontsource/cutive-mono": "^5.2.8",
    "@fontsource/dancing-script": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@fontsource/dotgothic16": "^5.2.8",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/exo-2": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/gochi-hand": "^5.2.8",
    "@fontsource/indie-flower": "^5.2.7",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/josefin-sans": "^5.2.8",
    "@fontsource/kalam": "^5.2.8",
    "@fontsource/libre-caslon-text": "^5.2.7",
    "@fontsource/lora": "^5.1.0",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/monoton": "^5.2.7",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/patrick-hand": "^5.2.8",
    "@fontsource/permanent-marker": "^5.2.7",
    "@fontsource/pixelify-sans": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/poiret-one": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fontsource/pt-serif": "^5.2.8",
    "@fontsource/quicksand": "^5.2.10",
    "@fontsource/rajdhani": "^5.2.7",
    "@fontsource/raleway": "^5.1.0",
    "@fontsource/righteous": "^5.2.7",
    "@fontsource/shadows-into-light-two": "^5.2.7",
    "@fontsource/silkscreen": "^5.2.8",
    "@fontsource/sixtyfour": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@fontsource/source-serif-4": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@fontsource/special-elite": "^5.2.8",
    "@fontsource/unbounded": "^5.2.8",
    "@fontsource/vt323": "^5.2.7",
    "@fontsource/work-sans": "^5.2.8",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "adm-zip": "^0.6.0",
    "electron-store": "^8.2.0",
    "markdown-it": "^14.1.0",
    "prosemirror-markdown": "^1.13.1",
    "simperium": "^1.1.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "svelte": "^4.2.18",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "io.github.fromchaoscomesclarity.scriptorium",
    "productName": "Scriptorium",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "artifactName": "${productName}-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "resources/icon.png",
      "artifactName": "${productName}.${ext}"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "npmRebuild": false
  }
}
